# lbp-decomp: only sources, tools, symbols, docs and scripts are versioned.
# Never versioned: build outputs, scratch (retail disassembly dumps, candidates, logs),
# Ghidra databases/exports/caches, Python caches.
/build/
/try/
/ghidra/projects/
/ghidra/out/
/ghidra/cache/
/ghidra/settings/
__pycache__/
*.pyc
# No binaries of any kind (retail modules, objects, compilers, archives).
*.o
*.obj
*.elf
*.bin
*.BIN
*.prx
*.PRX
*.pbp
*.PBP
*.iso
*.cso
*.exe
*.dll
*.so
*.a
*.zip
*.7z
*.gz
*.tar
*.gzf
*.rep
# No key material.
keys/
*keyfile*

# lbp-config.json: machine-specific paths (copy lbp-config.example.json); never versioned.
/lbp-config.json
# Maintainer-only campaign material kept outside the published history (workstation paths, private evidence,
# dated handoff notes).
/campaign-v*-scripts/
/docs/history/
/docs/*-INTEGRATION-*.md
/HANDOFF-*.md
# generated by tools/lbpreview.py (the owner's review decisions)
/reviews/
# generated by tools/lbpobjdiff.py (it names retail-derived objects under build/objdiff/)
/objdiff.json
# Retail inputs (ISO, decrypted modules, decryptor reports) and the campaign directory: never versioned.
/inputs/
/campaign/
# Large analysis exports (analyzer TOML, Ghidra CSV): regenerated from your own disc.
/analysis/
